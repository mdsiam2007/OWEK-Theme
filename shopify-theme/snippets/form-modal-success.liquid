<!-- OweK Success Feedback Modal matching Figma Frame 1982250921 -->
<div id="owek-success-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-content-card">
    <!-- Close Button matching Figma Button - Close dialog -->
    <button 
      type="button" 
      class="modal-close-btn" 
      id="modal-close"
      aria-label="Close dialog"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#525252" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Modal Inner Body matching Figma Frame 1982250921 -->
    <div class="modal-inner">
      <div class="modal-icon-container">
        <img 
          src="{{ 'image_1_16a6ff7d.png' | asset_url }}" 
          alt="Success Checkmark" 
          class="modal-success-icon" 
        />
      </div>

      <h3 class="modal-title" id="modal-title">Thank you!</h3>

      <p class="modal-message" id="modal-desc">
        We've received your query. A member of the OweK team will review your inquiry and get back to you within 24–48 hours.
      </p>

      <button type="button" class="navbar-waitlist-btn modal-done-btn" id="modal-ok-btn" style="margin-top: 24px; padding: 12px 36px; cursor: pointer;">
        <span>Done</span>
      </button>
    </div>
  </div>
</div>
