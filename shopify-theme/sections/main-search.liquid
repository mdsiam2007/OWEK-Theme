<div class="container" style="max-width: 1000px; margin: 0 auto; padding: 60px 24px; min-height: 50vh;">
  <h1 style="font-size: 36px; font-weight: 700; color: #111318; margin-bottom: 24px;">Search Results</h1>
  <form action="{{ routes.search_url }}" method="get" style="display: flex; gap: 12px; margin-bottom: 40px; max-width: 500px;">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search..." class="form-input" style="flex: 1;">
    <button type="submit" class="navbar-waitlist-btn"><span>Search</span></button>
  </form>
  {% if search.performed %}
    <p style="color: #6F6B65; margin-bottom: 24px;">Found {{ search.results_count }} result(s) for &ldquo;{{ search.terms }}&rdquo;</p>
    <div style="display: grid; gap: 20px;">
      {% for item in search.results %}
        <div style="padding: 20px; background: #FFF; border-radius: 12px; border: 1px solid #DDD8CF;">
          <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 6px;">
            <a href="{{ item.url }}" style="text-decoration: none; color: inherit;">{{ item.title }}</a>
          </h3>
          <p style="color: #4B5563; font-size: 14px;">{{ item.content | strip_html | truncatewords: 25 }}</p>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Search Main",
  "settings": []
}
{% endschema %}
