<section class="faq-section" id="faq">
  <div class="container faq-container">
    <!-- Left Column: Heading & Intro -->
    <div class="faq-intro-col">
      <div class="faq-badge-pill">
        <span>{{ section.settings.badge | default: 'Frequently Asked Questions' }}</span>
      </div>
      <h2 class="faq-title" style="white-space: pre-line;">
        {{ section.settings.title | default: "You have questions.\nWe’ve got answers." }}
      </h2>
      <p class="faq-description">
        {{ section.settings.desc | default: 'We’re building OweK with transparency, so you can make the best decision for your family or your school.' }}
      </p>
    </div>

    <!-- Right Column: Accordion List with Smooth CSS Grid Animation -->
    <div class="faq-list-col">
      {%- for block in section.blocks -%}
        <div class="faq-card {% if forloop.first %}open{% endif %}" {{ block.shopify_attributes }}>
          <div class="faq-card-header">
            <div class="faq-question-row">
              <h3 class="faq-question-text">{{ block.settings.question | escape }}</h3>
              <div class="faq-icon-action">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111318" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12" class="icon-line-horiz"></line>
                  <line x1="12" y1="5" x2="12" y2="19" class="icon-line-vert"></line>
                </svg>
              </div>
            </div>
          </div>

          <div class="faq-answer-collapse">
            <div class="faq-answer-inner">
              <p class="faq-answer-text">
                {{ block.settings.answer | escape }}
              </p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading Title",
      "default": "You have questions.\nWe’ve got answers."
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "We’re building OweK with transparency, so you can make the best decision for your family or your school."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is OweK?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "OweK is a financing platform for private school and camp tuition. Instead of paying the full bill at once, families can split tuition into manageable monthly payments — while the school or camp gets paid in full, upfront."
        }
      ]
    }
  ],
  "presets": [
    {
