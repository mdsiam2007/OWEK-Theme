<div class="container" style="max-width: 1000px; margin: 0 auto; padding: 60px 24px; min-height: 50vh;">
  <h1 style="font-size: 36px; font-weight: 700; color: #111318; margin-bottom: 32px;">{{ blog.title }}</h1>
  <div style="display: grid; gap: 32px;">
    {% for article in blog.articles %}
      <article style="padding: 24px; background: #FFF; border-radius: 16px; border: 1px solid #DDD8CF;">
        <h2 style="font-size: 24px; font-weight: 600; margin-bottom: 8px;">
          <a href="{{ article.url }}" style="text-decoration: none; color: inherit;">{{ article.title }}</a>
        </h2>
        <p style="color: #6F6B65; font-size: 14px; margin-bottom: 12px;">{{ article.published_at | date: "%B %d, %Y" }}</p>
        <p style="color: #4B5563; line-height: 1.6;">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
      </article>
    {% else %}
      <p style="color: #6F6B65;">No articles published yet.</p>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Blog Main",
  "settings": []
}
{% endschema %}
