<section class="contact-section" id="contact">
  <div class="container contact-container">
    <!-- Left Column: Heading & Description -->
    <div class="contact-intro-col">
      <div class="contact-badge-pill">
        <span>{{ section.settings.badge | default: 'Contact Us' }}</span>
      </div>
      <h2 class="contact-title">{{ section.settings.title | default: 'Questions? Let’s talk.' }}</h2>
      <p class="contact-description">
        {{ section.settings.desc | default: 'Whether you’re exploring tuition financing or interested in partnering with OweK, we’d love to hear from you.' }}
      </p>
    </div>

    <!-- Right Column: Contact Form Card matching Figma Frame 214:409 -->
    <div class="contact-form-card">
      {% form 'contact', class: 'contact-form' %}
        {%- if form.posted_successfully? -%}
          <div class="shopify-submission-success-marker" data-form-type="contact" style="display: none;"></div>
        {%- elsif form.errors -%}
          <div class="form-status form-status-error" tabindex="-1" autofocus style="padding: 16px; background: #FEF2F2; border: 1px solid #EF4444; border-radius: 12px; margin-bottom: 20px; color: #991B1B;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-row-2col">
          <!-- Full Name -->
          <div class="form-group">
            <label class="form-label" for="ContactForm-name">Full name</label>
            <input 
              type="text" 
              id="ContactForm-name"
              name="contact[name]" 
              placeholder="Jane Doe" 
              required 
              class="form-input"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            />
          </div>

          <!-- Email Address -->
          <div class="form-group">
            <label class="form-label" for="ContactForm-email">Your email address</label>
            <input 
              type="email" 
              id="ContactForm-email"
              name="contact[email]" 
              placeholder="jane@example.com" 
              required 
              class="form-input"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            />
          </div>
        </div>

        <!-- Role Select -->
        <div class="form-group">
          <label class="form-label" for="ContactForm-role">I am a...</label>
          <div class="select-wrapper">
            <select 
              id="ContactForm-role"
              name="contact[Role]" 
              class="form-select"
            >
              <option value="Parent or Family Member">Parent or Family Member</option>
              <option value="School Administrator">School Administrator</option>
              <option value="Camp Director">Camp Director</option>
              <option value="Financial Institution or Lending Partner">Financial Institution or Lending Partner</option>
              <option value="Other">Other</option>
            </select>
            <div class="select-arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6F6B65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>
        </div>

        <!-- Message Textarea -->
        <div class="form-group">
          <label class="form-label" for="ContactForm-body">How can we help?</label>
          <textarea 
            id="ContactForm-body"
            name="contact[body]" 
            rows="4"
            placeholder="Tell us about your school, camp, or family tuition needs..." 
            class="form-textarea"
          >{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
        </div>

        <!-- Submit Button -->
        <div class="form-submit-row">
          <button type="submit" class="contact-submit-btn">
            <span>{{ section.settings.btn_label | default: 'Send message' }}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow-icon">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Us",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading Title",
      "default": "Questions? Let’s talk."
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "Whether you’re exploring tuition financing or interested in partnering with OweK, we’d love to hear from you."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Submit Button Label",
      "default": "Send message"
    }
  ],
  "presets": [
    {
      "name": "Contact Us"
    }
  ]
}
{% endschema %}
