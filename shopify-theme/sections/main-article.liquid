<div class="container" style="max-width: 800px; margin: 0 auto; padding: 60px 24px; min-height: 50vh;">
  <h1 style="font-size: 40px; font-weight: 700; color: #111318; margin-bottom: 12px;">{{ article.title }}</h1>
  <p style="color: #6F6B65; margin-bottom: 32px;">{{ article.published_at | date: "%B %d, %Y" }} &bull; {{ article.author }}</p>
  {% if article.image %}
    <img src="{{ article.image | image_url: width: 1000 }}" alt="{{ article.title | escape }}" style="width: 100%; border-radius: 16px; margin-bottom: 32px;">
  {% endif %}
  <div style="line-height: 1.8; color: #374151; font-size: 17px;">
    {{ article.content }}
  </div>
</div>

{% schema %}
{
  "name": "Article Main",
  "settings": []
}
{% endschema %}
