<div class="container" style="max-width: 1200px; margin: 0 auto; padding: 60px 24px; min-height: 60vh;">
  <h1 style="font-size: 36px; font-weight: 700; color: #111318; margin-bottom: 32px;">{{ collection.title }}</h1>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px;">
    {% for product in collection.products %}
      <a href="{{ product.url }}" style="text-decoration: none; color: inherit; display: block; background: #FFF; border-radius: 16px; padding: 16px; border: 1px solid #DDD8CF;">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" style="width: 100%; height: 200px; object-fit: cover; border-radius: 12px; margin-bottom: 12px;">
        {% endif %}
        <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 8px;">{{ product.title }}</h3>
        <p style="color: #8B72F5; font-weight: 600;">{{ product.price | money }}</p>
      </a>
    {% else %}
      <p style="color: #6F6B65;">No products found in this collection.</p>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Main",
  "settings": []
}
{% endschema %}
