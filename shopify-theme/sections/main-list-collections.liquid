<div class="container" style="max-width: 1200px; margin: 0 auto; padding: 60px 24px; min-height: 50vh;">
  <h1 style="font-size: 36px; font-weight: 700; color: #111318; margin-bottom: 32px;">Collections</h1>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
    {% for collection in collections %}
      <a href="{{ collection.url }}" style="text-decoration: none; color: inherit; display: block; background: #FFF; border-radius: 16px; padding: 20px; border: 1px solid #DDD8CF; text-align: center;">
        {% if collection.featured_image %}
          <img src="{{ collection.featured_image | image_url: width: 400 }}" alt="{{ collection.title | escape }}" style="width: 100%; height: 180px; object-fit: cover; border-radius: 12px; margin-bottom: 12px;">
        {% endif %}
        <h3 style="font-size: 20px; font-weight: 600;">{{ collection.title }}</h3>
        <p style="color: #6F6B65; font-size: 14px;">{{ collection.all_products_count }} product(s)</p>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "List Collections Main",
  "settings": []
}
{% endschema %}
