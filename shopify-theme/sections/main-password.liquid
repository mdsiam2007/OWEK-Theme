<div class="password-card">
  <!-- Centered Brand Logo -->
  <div style="display: flex; justify-content: center; align-items: center; width: 100%; margin-bottom: 24px;">
    <img 
      src="{{ '214_8.svg' | asset_url }}" 
      alt="{{ shop.name }}" 
      class="password-logo"
      width="140"
      height="39"
      style="display: block; margin: 0 auto;"
    />
  </div>

  <!-- Badge Pill -->
  <div>
    <span class="password-pill-badge">Store Access</span>
  </div>

  <!-- Heading -->
  <h1 class="password-title">Opening Soon</h1>

  <!-- Subtitle -->
  <p class="password-desc">
    {% if shop.password_message != blank %}
      {{ shop.password_message }}
    {% else %}
      We're putting the finishing touches on our store. Enter the password below to access the site.
    {% endif %}
  </p>

  <!-- Red Highlighted Password Badge (1-Click Copy & Auto-Fill) -->
  <div>
    <div 
      id="copy-password-btn" 
      class="password-highlight-box" 
      role="button" 
      tabindex="0" 
      title="Click to copy password and auto-fill"
    >
      <svg id="copy-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="password-highlight-text" id="copy-label">
        Password is : <span class="password-highlight-val">siam</span>
      </span>
      <span id="copied-toast" style="display: none; color: #15803D; font-weight: 700; font-size: 15px; align-items: center; gap: 6px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Copied &amp; Auto-filled!
      </span>
    </div>
  </div>

  <!-- Storefront Password Form -->
  {% form 'storefront_password', class: 'password-form' %}
    {%- if form.errors -%}
      <div style="background: #FEF2F2; color: #991B1B; padding: 12px; border-radius: 12px; margin-bottom: 16px; font-size: 14px; border: 1px solid #EF4444;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="password-input-group">
      <input 
        type="password" 
        name="password" 
        id="Password" 
        class="password-input-field" 
        placeholder="Enter store password"
        autofocus
        autocomplete="current-password"
        required
      />
      <button type="submit" class="password-submit-btn">
        <span>Enter Store</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>
  {% endform %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var copyBtn = document.getElementById('copy-password-btn');
    var passwordInput = document.getElementById('Password');
    var copyIcon = document.getElementById('copy-icon');
    var copyLabel = document.getElementById('copy-label');
    var copiedToast = document.getElementById('copied-toast');

    if (copyBtn) {
      function doCopyPassword() {
        var pwd = 'siam';
        // Copy to clipboard
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(pwd).catch(function () {});
        } else {
          var tempInput = document.createElement('input');
          tempInput.value = pwd;
          document.body.appendChild(tempInput);
          tempInput.select();
          document.execCommand('copy');
          document.body.removeChild(tempInput);
        }

        // Auto-fill into the input field
        if (passwordInput) {
          passwordInput.value = pwd;
          passwordInput.focus();
        }

        // Show visual feedback
        if (copiedToast && copyLabel) {
          copyLabel.style.display = 'none';
          if (copyIcon) copyIcon.style.display = 'none';
          copiedToast.style.display = 'inline-flex';
          copyBtn.style.borderColor = '#22C55E';
          copyBtn.style.backgroundColor = '#F0FDF4';

          setTimeout(function () {
            copyLabel.style.display = 'inline';
            if (copyIcon) copyIcon.style.display = 'block';
            copiedToast.style.display = 'none';
            copyBtn.style.borderColor = '#F87171';
            copyBtn.style.backgroundColor = '#FEF2F2';
          }, 2200);
        }
      }

      copyBtn.addEventListener('click', doCopyPassword);
      copyBtn.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          doCopyPassword();
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Password Main",
  "settings": []
}
{% endschema %}
