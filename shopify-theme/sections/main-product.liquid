<div class="container" style="max-width: 1200px; margin: 0 auto; padding: 60px 24px; min-height: 60vh;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: start;">
    <div>
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" style="width: 100%; border-radius: 16px; object-fit: cover;">
      {% endif %}
    </div>
    <div>
      <h1 style="font-size: 36px; font-weight: 700; color: #111318; margin-bottom: 12px;">{{ product.title }}</h1>
      <div style="font-size: 24px; font-weight: 600; color: #8B72F5; margin-bottom: 24px;">{{ product.price | money }}</div>
      <div style="line-height: 1.7; color: #4B5563; margin-bottom: 32px;">{{ product.description }}</div>
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="navbar-waitlist-btn" style="width: 100%; justify-content: center;" {% unless product.available %}disabled{% endunless %}>
          <span>{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
        </button>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Main",
  "settings": []
}
{% endschema %}
