<div class="container" style="max-width: 900px; margin: 0 auto; padding: 60px 24px; min-height: 50vh;">
  <h1 style="font-size: 36px; font-weight: 700; color: #111318; margin-bottom: 24px;">Your Cart</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      <div style="margin-bottom: 32px;">
        {% for item in cart.items %}
          <div style="display: flex; gap: 20px; align-items: center; padding: 16px 0; border-bottom: 1px solid #DDD8CF;">
            {% if item.image %}
              <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px;">
            {% endif %}
            <div style="flex: 1;">
              <h3 style="font-size: 18px; font-weight: 600;">{{ item.product.title }}</h3>
              <p style="color: #6F6B65;">{{ item.variant.title }}</p>
              <p style="color: #8B72F5; font-weight: 600;">{{ item.price | money }} &times; {{ item.quantity }}</p>
            </div>
            <div>
              <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="color: #EF4444; font-size: 14px;">Remove</a>
            </div>
          </div>
        {% endfor %}
      </div>
      <div style="text-align: right;">
        <p style="font-size: 20px; font-weight: 700; margin-bottom: 16px;">Total: {{ cart.total_price | money }}</p>
        <button type="submit" name="checkout" class="navbar-waitlist-btn">
          <span>Checkout</span>
        </button>
      </div>
    </form>
  {% else %}
    <p style="color: #6F6B65; margin-bottom: 24px;">Your cart is currently empty.</p>
    <a href="{{ routes.all_products_collection_url }}" class="navbar-waitlist-btn" style="text-decoration: none;">
      <span>Continue Shopping</span>
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart Main",
  "settings": []
}
{% endschema %}
