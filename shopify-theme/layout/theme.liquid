<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Google Fonts: Plus Jakarta Sans & Instrument Serif -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

  <!-- Dynamic Theme Variables from Shopify Customizer -->
  <style>
    :root {
      --color-primary: {{ settings.color_primary_purple | default: '#8B72F5' }};
      --color-primary-hover: {{ settings.color_purple_hover | default: '#7A61E4' }};
      --color-bg-cream: {{ settings.color_cream | default: '#FFF9F2' }};
      --color-yellow-badge: {{ settings.color_accent_yellow | default: '#FFDC73' }};
    }
  </style>

  <!-- OweK Pixel Perfect Stylesheet -->
  {{ 'owek-main.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>

<body class="owek-body template-{{ template.name }}">
  <a class="skip-to-content-link visually-hidden" href="#MainContent">
    Skip to content
  </a>

  {% section 'header' %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'form-modal-success' %}

  <!-- OweK Interactions & AJAX Scripts -->
  {{ 'owek-main.js' | asset_url | script_tag }}
</body>
</html>
