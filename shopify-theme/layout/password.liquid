<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ shop.name }} &ndash; Opening Soon</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

  {{ content_for_header }}
  {{ 'owek-main.css' | asset_url | stylesheet_tag }}

  <style>
    body.password-page-body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000C2A;
      background-image: 
        radial-gradient(circle at 50% 15%, rgba(139, 114, 245, 0.22) 0%, transparent 60%),
        radial-gradient(circle at 80% 85%, rgba(255, 220, 115, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 20% 80%, rgba(139, 114, 245, 0.12) 0%, transparent 50%);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      padding: 24px;
      box-sizing: border-box;
      position: relative;
      overflow-x: hidden;
    }

    .password-page-wrapper {
      width: 100%;
      max-width: 540px;
      position: relative;
      z-index: 2;
    }

    .password-card {
      background: #FFFFFF;
      border-radius: 28px;
      padding: 48px 40px;
      box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
      text-align: center;
      box-sizing: border-box;
      position: relative;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    @media (max-width: 600px) {
      .password-card {
        padding: 36px 24px;
        border-radius: 24px;
      }
    }

    .password-logo {
      display: block;
      margin: 0 auto 20px auto;
      max-width: 150px;
      height: auto;
    }

    .password-pill-badge {
      display: inline-block;
      background: #FFE897;
      color: #111318;
      font-size: 13px;
      font-weight: 600;
      padding: 6px 16px;
      border-radius: 9999px;
      margin-bottom: 16px;
    }

    .password-title {
      font-size: 32px;
      font-weight: 800;
      color: #111318;
      margin: 0 0 12px 0;
      letter-spacing: -0.5px;
    }

    .password-desc {
      color: #6F6B65;
      font-size: 15px;
      line-height: 1.6;
      margin: 0 0 20px 0;
    }

    /* Red Highlighted Password Badge (Click-to-Copy) */
    .password-highlight-box {
      background: #FEF2F2;
      border: 1.5px solid #F87171;
      border-radius: 14px;
      padding: 12px 24px;
      margin: 0 auto 24px auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      user-select: none;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
      box-shadow: 0 3px 10px rgba(220, 38, 38, 0.08);
    }

    .password-highlight-box:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(220, 38, 38, 0.16);
      background: #FEE2E2;
      border-color: #DC2626;
    }

    .password-highlight-box:active {
      transform: translateY(0);
    }

    .password-highlight-text {
      color: #991B1B;
      font-size: 15px;
      font-weight: 600;
    }

    .password-highlight-val {
      color: #DC2626;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 1px;
      text-decoration: underline;
      background: #FFFFFF;
      padding: 3px 10px;
      border-radius: 8px;
      margin-left: 6px;
      border: 1px dashed #F87171;
    }

    .password-input-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .password-input-field {
      width: 100%;
      height: 54px;
      padding: 0 22px;
      border: 1.5px solid #DDD8CF;
      border-radius: 9999px;
      font-size: 15px;
      font-family: inherit;
      outline: none;
      box-sizing: border-box;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      color: #111318;
      text-align: center;
    }

    .password-input-field:focus {
      border-color: #8B72F5;
      box-shadow: 0 0 0 3px rgba(139, 114, 245, 0.18);
    }

    .password-submit-btn {
      width: 100%;
      height: 54px;
      background: #8B72F5;
      color: #FFFFFF;
      border: none;
      border-radius: 9999px;
      font-size: 16px;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 14px rgba(139, 114, 245, 0.35);
    }

    .password-submit-btn:hover {
      background: #7A61E4;
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(139, 114, 245, 0.45);
    }

    .password-submit-btn:active {
      transform: translateY(0);
    }

    .password-footer-text {
      margin-top: 24px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.45);
      text-align: center;
    }
  </style>
</head>
<body class="password-page-body">
  <div class="password-page-wrapper">
    {{ content_for_layout }}
    <div class="password-footer-text">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
    </div>
  </div>
</body>
</html>
